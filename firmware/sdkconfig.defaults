CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
# The board is monitored through native USB Serial/JTAG; secondary console cannot receive commands.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_CANX2_MODE_LIVE=y
# CONFIG_CANX2_MODE_SYNTHETIC is not set
CONFIG_CANX2_GEAR_ECHO=y
# Custom Generic CAN 0x370 APP percent = raw / 10 by default.
CONFIG_CANX2_PEDAL_SCALE_NUMERATOR=1
CONFIG_CANX2_PEDAL_SCALE_DENOMINATOR=10
# CONFIG_CANX2_RAW_LOG is not set
